{
  "expo": {
    "name": "yupresence",
    "slug": "yupresence",
    "version": "1.0.0",
    "scheme": "yupresence",
    "ios": {
      "bundleIdentifier": "com.nabs.yupresence"
    },
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-dev-client",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow YuPresence to use Face ID to verify your identity when marking attendance."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Yupresence to scan attendance QR codes."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Yupresence to verify your attendance location."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.nabs.yupresence"
    }
  }
}
