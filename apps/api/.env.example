# When Docker Compose is used, set POSTGRES_PASSWORD and JWT_SECRET in the
# root .env file. For an API running directly on the host, use matching values
# in DATABASE_URL and JWT_SECRET below.
DATABASE_URL="postgresql://yupresence:replace-with-your-local-postgres-password@localhost:5432/yupresence?schema=public"
JWT_SECRET="replace-with-a-strong-random-jwt-signing-secret"
# Keep false locally; set to 1 only when one known reverse proxy supplies
# X-Forwarded-For in production.
TRUST_PROXY=false
CORS_ORIGINS="http://localhost:8081,http://localhost:8082,http://localhost:5173,http://192.168.x.x:5173"
