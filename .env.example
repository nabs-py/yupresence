# Copy to .env for local Docker development and replace both placeholders.
# Keep this file free of real credentials.
POSTGRES_PASSWORD=replace-with-a-strong-random-local-postgres-password
JWT_SECRET=replace-with-a-strong-random-jwt-signing-secret
# Keep false for direct local Docker access. Set to 1 only behind one known
# hosting reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
